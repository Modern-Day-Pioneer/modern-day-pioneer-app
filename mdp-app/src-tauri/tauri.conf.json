{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modern Day Pioneer",
  "version": "0.14.0",
  "identifier": "org.moderndaypioneer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Modern Day Pioneer",
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' asset: http://asset.localhost http://127.0.0.1:*",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "A family history that lasts",
    "android": { "minSdkVersion": 26 },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
